*.salt
auth.secret
issuance.log*

# keys and wallets — never commit
keys/
**/keys/*.json
*keypair*.json
*-payout.json
treasury*.json
id.json
*.pem
*.key

# build output and logs
dist/
dist-static/
*.log
coverage/
.DS_Store
Thumbs.db
