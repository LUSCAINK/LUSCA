# Normalize text files to LF in the repository and in working trees.
* text=auto eol=lf

# Binary assets: never convert line endings or diff as text.
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.webp   binary
*.ico    binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.otf    binary
*.ckpt   binary

# Generated files: collapse in GitHub diffs.
package-lock.json  linguist-generated=true
